# Copy this file to ".env" and fill in your real values.
# ---------------------------------------------------------
# Connection string to your EXISTING school database.
# Format for MySQL:  mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# Format for Postgres: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=mysql+pymysql://Bodoque:hola1234*@localhost:3306/Universidad

# Random long strings used to sign sessions/tokens. Change these!
SECRET_KEY=change-this-super-secret-key
JWT_SECRET_KEY=change-this-other-super-secret-key

# Where uploaded files (tareas, boletas, fotos) are stored on disk
UPLOAD_FOLDER=uploads

# Comma-separated list of origins allowed to call the API (your React dev server / production domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
